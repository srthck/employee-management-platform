# Server
PORT=5000
NODE_ENV=development
# Set when running behind a proxy / load balancer (e.g. 1, or true) so rate
# limits and audit IPs use the real client address.
TRUST_PROXY=
JSON_BODY_LIMIT=1mb

# Database (MongoDB Atlas or local)
# Financial writes need transactions, i.e. a replica set. Atlas is one.
# Local single-node replica set on port 27018: npm run db:start
MONGO_URI=mongodb://127.0.0.1:27018/employee_management?replicaSet=rs0
# Transactions are required in every environment and the server refuses to
# start without them. "false" is an explicit, non-production escape hatch that
# makes payroll writes NON-atomic; it is ignored when NODE_ENV=production.
REQUIRE_TRANSACTIONS=true

# Authentication (use a long random string in production; at least 32 chars)
JWT_SECRET=replace-with-a-strong-random-secret-min-32-chars
JWT_EXPIRE=1d
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MS=900000

# CORS
FRONTEND_URL=http://localhost:5173
# Extra allowed origins, comma separated
CORS_ORIGINS=

# Authentication cookie (HttpOnly; Secure is enforced automatically in production)
AUTH_COOKIE_NAME=payguard_session
AUTH_COOKIE_SAMESITE=strict

# Abuse protection
RATE_LIMIT_ENABLED=true

# Payroll operations
# A PROCESSING run with no heartbeat for this long is failed automatically.
STUCK_RUN_THRESHOLD_MS=1800000
# How often the stuck-run monitor checks (0 disables it)
STUCK_RUN_MONITOR_INTERVAL_MS=300000
# Variance report: flag gross / net changes at or above this percentage
VARIANCE_THRESHOLD_PERCENT=10

# How often approved future-dated pay changes are marked effective (0 disables)
COMPENSATION_ACTIVATION_INTERVAL_MS=900000

# Idempotency-Key records are kept this long, then expire
IDEMPOTENCY_TTL_HOURS=24

# Field-level encryption for statutory and bank identifiers (AES-256-GCM).
# REQUIRED: the server refuses to start without working keys.
# Keys: comma-separated "<id>:<base64 32 bytes>"; keep old keys so old values
# stay readable. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Store production keys in a secret manager, never in the repository.
FIELD_ENCRYPTION_KEYS=
# Key id for new values (defaults to the last key listed)
FIELD_ENCRYPTION_ACTIVE_KEY=
# REQUIRED separate secret for exact-match lookups on encrypted values
# (duplicate PAN, shared bank accounts). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_BLIND_INDEX_KEY=

# Logging: error | warn | info | debug
LOG_LEVEL=info
